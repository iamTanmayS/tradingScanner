# Frontend environment variables — copy to .env or configure in hosting provider (Vercel, Netlify, Cloudflare Pages, etc.)

# Backend WebSocket server URL
# In local development: defaults to ws://localhost:4000
# In production: set to your deployed backend WebSocket URL (use wss:// for HTTPS sites)
# VITE_WS_URL=wss://api.yourdomain.com

# Backend HTTP API URL (used for historical klines fallback proxy)
# In local development: defaults to http://localhost:4000
# In production: set to your deployed backend HTTP URL (use https:// for HTTPS sites)
# VITE_API_URL=https://api.yourdomain.com

