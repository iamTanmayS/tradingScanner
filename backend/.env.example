# Backend configuration — copy to .env and adjust as needed

# Port the backend HTTP & WebSocket server listens on
PORT=4000

# How many top coins (by 24h volume) to seed indicators for
# 0 = seed all eligible USDT pairs (recommended for full coverage)
# > 0 = seed only the top N coins by volume
SEED_COIN_LIMIT=0

# Simultaneous klines requests during indicator seeding (keep <= 3 to protect Binance rate limits)
SEED_CONCURRENCY=2

# Number of 1h candles to fetch per coin during seeding (minimum 21 for all indicators)
SEED_CANDLE_COUNT=30

# Binance REST API base URL
BINANCE_REST_URL=https://api.binance.com

# Binance WebSocket stream URL
BINANCE_WS_URL=wss://stream.binance.com:9443/ws/!miniTicker@arr

